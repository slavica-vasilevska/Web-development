<!DOCTYPE html>
<html>
<head>
    <title>Password Generator</title>
    <style>
        body {
            font-family: Arial, Helvetica, sans-serif;
            background-color: #f4f6f8;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            margin: 0;
        }

        .container {
            background-color: white;
            padding: 25px 30px;
            border-radius: 10px;
            box-shadow: 0 4px 10px rgba(0,0,0,0.1);
            width: 320px;
            text-align: center;
        }

        h1 {
            margin-bottom: 20px;
            color: #333;
        }

        input[type="text"] {
            width: 100%;
            padding: 10px;
            font-size: 16px;
            margin-bottom: 10px;
            border: 1px solid #ccc;
            border-radius: 6px;
            text-align: center;
        }

        input[type="number"] {
            width: 70px;
            padding: 6px;
            margin-left: 5px;
        }

        .options {
            text-align: left;
            margin-top: 15px;
            margin-bottom: 15px;
        }

        .options label {
            display: block;
            margin-bottom: 5px;
        }

        button {
            width: 100%;
            padding: 10px;
            font-size: 16px;
            background-color: #4CAF50;
            color: white;
            border: none;
            border-radius: 6px;
            cursor: pointer;
        }

        button:hover {
            background-color: #43a047;
        }

        .strength {
            margin-top: 10px;
            font-weight: bold;
        }
    </style>
</head>
<body>

<div class="container">

    <h1>Password Generator</h1>

    <input type="text" id="password" placeholder="Generated password" readonly>

    <div>
        Length:
        <input type="number" id="length" value="8" min="4" max="20">
    </div>

    <div class="options">
        <label>
            <input type="checkbox" id="uppercase" checked>
            Include Uppercase Letters
        </label>

        <label>
            <input type="checkbox" id="lowercase" checked>
            Include Lowercase Letters
        </label>

        <label>
            <input type="checkbox" id="numbers" checked>
            Include Numbers
        </label>

        <label>
            <input type="checkbox" id="symbols">
            Include Symbols
        </label>
    </div>

    <button onclick="generatePassword()">Generate Password</button>

    <div id="strength" class="strength">Strength: -</div>

</div>

<script>
    function generatePassword() {
        var length = document.getElementById("length").value;

        var upper = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
        var lower = "abcdefghijklmnopqrstuvwxyz";
        var numbers = "0123456789";
        var symbols = "!@#$%^&*";

        var chars = "";

        var useUpper = document.getElementById("uppercase").checked;
        var useLower = document.getElementById("lowercase").checked;
        var useNumbers = document.getElementById("numbers").checked;
        var useSymbols = document.getElementById("symbols").checked;

        if (useUpper) chars += upper;
        if (useLower) chars += lower;
        if (useNumbers) chars += numbers;
        if (useSymbols) chars += symbols;

        if (chars === "") {
            alert("Select at least one option");
            return;
        }

        var password = "";

        for (var i = 0; i < length; i++) {
            var randomIndex = Math.floor(Math.random() * chars.length);
            password += chars[randomIndex];
        }

        document.getElementById("password").value = password;

        updateStrength(password, useUpper, useLower, useNumbers, useSymbols);
    }

    function updateStrength(password, u, l, n, s) {
        var score = 0;

        if (password.length >= 10) score++;
        if (u) score++;
        if (l) score++;
        if (n) score++;
        if (s) score++;

        var strengthText = document.getElementById("strength");

        if (score <= 2) {
            strengthText.innerText = "Strength: Weak";
            strengthText.style.color = "red";
        } else if (score <= 4) {
            strengthText.innerText = "Strength: Medium";
            strengthText.style.color = "orange";
        } else {
            strengthText.innerText = "Strength: Strong";
            strengthText.style.color = "green";
        }
    }
</script>

</body>
</html>
