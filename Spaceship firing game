<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Alien invasion</title>
    <style>
        #ship {
            /*position: absolute;*/
            height: 50px;
            width: 120px;
        }

        #alien {
            position: absolute;
            height: 120px;
            width: 120px;
        }

        #bullet {
            position: absolute;
            height: 3px;
            width: 80px;
            background: red;
            left: 110px;
            top: 35px;
            display: none;
        }

        #container {
            position: absolute;
            height: 50px;
            top: 50px;
        }
    </style>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/animejs/3.2.1/anime.min.js"></script>
</head>
<body>
<div>
    <button id="up" onclick="up()">Up</button>
    <button id="down" onclick="down()">Down</button>
    <button id="shoot" onclick="shoot()">Shoot</button>
</div>

<div id="container">
    <img src="https://clipart-library.com/8300/2368/military-jet-clipart-xl.png" id="ship">
    <div id="bullet"></div>
</div>
<img src="https://cdn-icons-png.flaticon.com/256/10757/10757757.png" id="alien">

<script>
    let x = Math.floor(Math.random()*1200 + 180);
    let y = Math.floor(Math.random()*500 + 70);

    let bullet = document.getElementById("bullet");
    let ship = document.getElementById("container");
    let alien = document.getElementById("alien");

    alien.style.left = x + "px";
    alien.style.top = y + "px";

    ship.style.top = "50px";


    function up() {
        let ship_position = ship.style.top.valueOf();
        ship_position = parseInt(ship_position);
        if (ship_position > 50)
            ship.style.top = (ship_position-15) + "px";
    }

    function down() {
        let ship_position = ship.style.top.valueOf();
        ship_position = parseInt(ship_position);
        ship.style.top = (ship_position+15) + "px";
    }

    function shoot() {
        bullet.style.display = "inline-block";
        let bullet_position = ship.style.top.valueOf();
        bullet_position = parseInt(bullet_position) + 25;
        console.log(bullet_position);

        anime({
            targets: '#bullet',
            translateX: x,
            easing: "linear",
            duration: 500
        });

        if (bullet_position > y &&  bullet_position < y + 120) {
            setTimeout(kill, 500);
        }

        setTimeout(function (){
            bullet.style.display = "none";
        }, 700);
    }

    function kill() {
        alien.style.display = "none";
    }
</script>
</body>
</html>
