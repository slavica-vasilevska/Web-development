<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>FocusFlow – Study Session Tracker</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gradient-to-br from-indigo-100 to-purple-100 min-h-screen font-sans">


<header class="p-6 text-center">
    <h1 class="text-4xl font-bold text-indigo-700">FocusFlow ⏳</h1>
</header>


<main class="max-w-5xl mx-auto p-6 grid md:grid-cols-2 gap-6">

    <div class="bg-white rounded-2xl shadow-lg p-6">
        <h2 class="text-xl font-semibold mb-4">Pomodoro Timer</h2>
        <div class="text-5xl font-mono text-center mb-6" id="timer">25:00</div>
        <div class="flex justify-center gap-4">
            <button onclick="startTimer()" class="bg-green-500 text-white px-4 py-2 rounded-xl hover:bg-green-600">Start</button>
            <button onclick="pauseTimer()" class="bg-yellow-500 text-white px-4 py-2 rounded-xl hover:bg-yellow-600">Pause</button>
            <button onclick="resetTimer()" class="bg-red-500 text-white px-4 py-2 rounded-xl hover:bg-red-600">Reset</button>
        </div>
    </div>

    <div class="bg-white rounded-2xl shadow-lg p-6">
        <h2 class="text-xl font-semibold mb-4">Today's Tasks</h2>
        <div class="flex gap-2 mb-4">
            <input id="taskInput" type="text" placeholder="Add a task..." class="flex-1 border rounded-xl px-3 py-2" />
            <button onclick="addTask()" class="bg-indigo-600 text-white px-4 py-2 rounded-xl hover:bg-indigo-700">Add</button>
        </div>
        <ul id="taskList" class="space-y-2"></ul>
    </div>


    <div class="bg-white rounded-2xl shadow-lg p-6 md:col-span-2">
        <h2 class="text-xl font-semibold mb-4">Session Stats</h2>
        <div class="grid grid-cols-3 text-center">
            <div>
                <p class="text-3xl font-bold text-indigo-600" id="sessions">0</p>
                <p class="text-gray-500">Sessions Completed</p>
            </div>
            <div>
                <p class="text-3xl font-bold text-indigo-600" id="minutes">0</p>
                <p class="text-gray-500">Minutes Focused</p>
            </div>
            <div>
                <p class="text-3xl font-bold text-indigo-600" id="tasksDone">0</p>
                <p class="text-gray-500">Tasks Done</p>
            </div>
        </div>
    </div>

</main>

<script>
    let time = 1500;
    let timerInterval;
    let sessions = 0;
    let minutes = 0;
    let tasksDone = 0;

    function updateDisplay() {
        let mins = Math.floor(time / 60);
        let secs = time % 60;
        document.getElementById("timer").innerText =
            String(mins).padStart(2, "0") + ":" + String(secs).padStart(2, "0");
    }

    function startTimer() {
        if (timerInterval) return;
        timerInterval = setInterval(() => {
            if (time > 0) {
                time--;
                updateDisplay();
            } else {
                clearInterval(timerInterval);
                timerInterval = null;
                sessions++;
                minutes += 25;
                document.getElementById("sessions").innerText = sessions;
                document.getElementById("minutes").innerText = minutes;
                alert("Session complete! 🎉");
            }
        }, 1000);
    }

    function pauseTimer() {
        clearInterval(timerInterval);
        timerInterval = null;
    }

    function resetTimer() {
        pauseTimer();
        time = 1500;
        updateDisplay();
    }

    function addTask() {
        const input = document.getElementById("taskInput");
        const taskText = input.value.trim();
        if (taskText === "") return;

        const li = document.createElement("li");
        li.className = "flex justify-between items-center bg-gray-100 px-3 py-2 rounded-xl";

        const span = document.createElement("span");
        span.innerText = taskText;

        const btn = document.createElement("button");
        btn.innerText = "Done";
        btn.className = "bg-green-500 text-white px-2 py-1 rounded-lg hover:bg-green-600";
        btn.onclick = () => {
            li.remove();
            tasksDone++;
            document.getElementById("tasksDone").innerText = tasksDone;
        };

        li.appendChild(span);
        li.appendChild(btn);
        document.getElementById("taskList").appendChild(li);

        input.value = "";
    }

    updateDisplay();
</script>

</body>
</html>
